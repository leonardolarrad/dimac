<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="d21_multimoneda.SwitchCurrencyItem">
    <span
        class="d-flex o_switch_currency_item dropdown-item p-0 w-100"
        t-att-class="{
            'o-navigable': true,
            'alert-secondary': isCurrencySelected,
        }"
        tabindex="0"
        data-menu="currency"
        t-att-data-currency-id="props.currency.id"
    >
        <div
            role="menuitemcheckbox"
            t-att-aria-checked="isCurrencySelected ? 'true' : 'false'"
            t-att-aria-label="props.currency.name"
            t-att-title="(isCurrencySelected ? 'Hide ' : 'Show ') + props.currency.name"
            class="border-end"
            t-att-class="{ 'border-primary': isCurrencySelected }"
            t-on-click.stop="() => this.toggleCurrency()"
        >
            <span class="btn border-0 px-2 btn-link text-primary">
                <i class="fa fa-fw py-1" t-att-class="isCurrencySelected ? 'fa-check-square text-primary' : 'fa-square-o'"/>
            </span>
        </div>

        <div
            role="button"
            t-att-aria-pressed="isCurrent ? 'true' : 'false'"
            t-att-aria-label="'Switch to ' + props.currency.name"
            t-att-title="'Switch to ' + props.currency.name"
            class="d-flex flex-grow-1 align-items-center py-0 log_into ps-2"
            t-att-class="isCurrent ? 'bg-primary-subtle' : 'btn fw-normal border-0 btn-link text-primary'"
            t-on-click="() => this.logIntoCurrency()"
        >
            <span class="currency_label text-700 text-truncate">
                <t t-out="props.currency.name"/> (<t t-out="props.currency.symbol"/>)
            </span>
        </div>
    </span>
</t>

</templates>
