<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action to trigger the installation -->
    <record id="instalar_modulos_multimoneda_server" model="ir.actions.server">
        <field name="name">Instalar modulos multimoneda</field>
        <field name="model_id" ref="base.model_ir_module_module"/>
        <field name="state">code</field>
        <field name="code">
            action = model.instalar_modulos_multimoneda()
        </field>
    </record>

    <!-- Menu Item in the Apps menu -->
    <menuitem id="menu_install_sale_ia"
              name="Instalar modulos multimoneda"
              parent="base.menu_management"
              action="instalar_modulos_multimoneda_server"
              sequence="100"/>
</odoo>
